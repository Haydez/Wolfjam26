  themeTrack: {fileID: 0}
  lines:
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: 'Greetings. '
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 1
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: So I hear that despite how popular you've become...
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: You want more.
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 2
    typingSpeed: 0.01
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: You want to go beyond your popularity and become a...
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: Star
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 3
    typingSpeed: 0.01
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: 'YOU WANT MORE '
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.01
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: 'VISIBILITY '
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 1
    typingSpeed: 0.08
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: To help you become a star, I need you to go to the 3 realms and collect
      certain things for me...
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: From the Wizard Clown school I need magic beans.
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: From the Hallo-Party world I need the fertiziler of cool.
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: And from the Cave-Mart, I need the trendy mineral water.
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
  - characterName: Tower Wizard
    portrait: {fileID: 21300000, guid: 592423723f7c91843a92305140a42e6d, type: 3}
    text: Collect those 3 things for me and you'll see just how much more... VISIBLE
      you can get.
    typingSound: {fileID: 8300000, guid: a4928158d3aa86e439d5ccccadd85d91, type: 3}
    effect: 0
    typingSpeed: 0.05
    expression: 0
    emoteTrigger: 
