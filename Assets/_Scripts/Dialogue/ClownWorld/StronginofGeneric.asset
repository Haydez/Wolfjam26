  - characterName: Stronginof
    portrait: {fileID: 21300000, guid: c9dd132b02c3ff34e863d9789256107f, type: 3}
    text: Ah yes! I remember! The missing clown really loved his clown hat collection!
    typingSound: {fileID: 8300000, guid: d5a533322c436074c8066f5b26268a7a, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: Stronginof
    portrait: {fileID: 21300000, guid: c9dd132b02c3ff34e863d9789256107f, type: 3}
    text: "To the point he made one of \nthe numbers in his locker combination the
      amount of clown hats he has haha!"
    typingSound: {fileID: 8300000, guid: d5a533322c436074c8066f5b26268a7a, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: Stronginof
    portrait: {fileID: 21300000, guid: c9dd132b02c3ff34e863d9789256107f, type: 3}
    text: 'He left them scattered all over the worlds! Go find and count them! '
