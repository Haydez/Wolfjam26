  - characterName: THE Elephant
    portrait: {fileID: 21300000, guid: 6935c4810d074ef4380cd579f395aefc, type: 3}
    text: I am THE Elephant. The most famous Elephant around.
    typingSound: {fileID: 8300000, guid: 596765ced2049be41b0414dd76260e5e, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: THE Elephant
    portrait: {fileID: 21300000, guid: 6935c4810d074ef4380cd579f395aefc, type: 3}
    text: You are THE Star Diva! The most famous person around!
    typingSound: {fileID: 8300000, guid: 596765ced2049be41b0414dd76260e5e, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: THE Elephant
    portrait: {fileID: 21300000, guid: 6935c4810d074ef4380cd579f395aefc, type: 3}
    text: You're trying to get even MORE visibility? More than me? Good luck with
      that!
    typingSound: {fileID: 8300000, guid: 596765ced2049be41b0414dd76260e5e, type: 3}
    effect: 1
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
