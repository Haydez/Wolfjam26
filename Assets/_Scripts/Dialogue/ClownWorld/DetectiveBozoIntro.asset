  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 596e78bc42dd47746b5c2aca0af9beb9, type: 3}
  m_Name: DetectiveBozoIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  themeTrack: {fileID: 0}
  lines:
  - characterName: Detective Bozo
    portrait: {fileID: 21300000, guid: 45ba076ba6832fb4b915ee2cee004d45, type: 3}
    text: Oh! Hello, Star Dust! Good thing you're here.
    typingSound: {fileID: 8300000, guid: 94d563d89de0b274996359970d826695, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: Detective Bozo
    portrait: {fileID: 21300000, guid: 45ba076ba6832fb4b915ee2cee004d45, type: 3}
    text: A CLOWN HAS GONE MISSING!
    typingSound: {fileID: 8300000, guid: 94d563d89de0b274996359970d826695, type: 3}
    effect: 2
    typingSpeed: 0.01
    expression: 0
    emoteTrigger: 
  - characterName: Detective Bozo
    portrait: {fileID: 21300000, guid: 45ba076ba6832fb4b915ee2cee004d45, type: 3}
    text: And right before the big show. I've been putting together a clue board...
    typingSound: {fileID: 8300000, guid: 94d563d89de0b274996359970d826695, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: Detective Bozo
    portrait: {fileID: 21300000, guid: 45ba076ba6832fb4b915ee2cee004d45, type: 3}
    text: Oh? You're looking for magic beans? I believe our missing clown had those
      on him.
    typingSound: {fileID: 8300000, guid: 94d563d89de0b274996359970d826695, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: Detective Bozo
    portrait: {fileID: 21300000, guid: 45ba076ba6832fb4b915ee2cee004d45, type: 3}
    text: If you can find him, they're all yours! Look around for clues! Good luck,
      Star girl!
    typingSound: {fileID: 8300000, guid: 94d563d89de0b274996359970d826695, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
  - characterName: Detective Bozo
    portrait: {fileID: 21300000, guid: 45ba076ba6832fb4b915ee2cee004d45, type: 3}
    text: Here's a magnifying glass. It's behind me on the floor to the right.
    typingSound: {fileID: 8300000, guid: 94d563d89de0b274996359970d826695, type: 3}
    effect: 0
    typingSpeed: 0.03
    expression: 0
    emoteTrigger: 
